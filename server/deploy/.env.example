# Copy to .env next to compose.yml and adjust before `docker compose up -d`.
# See docs/v2/DEPLOY.md for what each variable does.

# Domain Caddy requests a certificate for and proxies to sparagne:3000.
DOMAIN=sparagne.example.com

# The server release to run: ghcr.io/oghma/sparagne-server:<this>. Change it
# to upgrade, after a backup (docs/v2/DEPLOY.md §6).
SPARAGNE_VERSION=2.0.0

# Open only long enough to create the first accounts, then set to false and
# restart the sparagne service. With it closed, accounts are made with
# `sparagne-server user add` (docs/v2/DEPLOY.md §3).
SPARAGNE_ALLOW_REGISTRATION=true

# How many days a login token stays valid.
SPARAGNE_TOKEN_TTL_DAYS=30

# Take the client address from the rightmost X-Forwarded-For entry, for the
# per-address limits below. compose.yml turns it on, because only Caddy can
# reach the server there. On bare metal set it to true only when the server
# listens on 127.0.0.1 behind a proxy that appends the client address to
# X-Forwarded-For (Caddy does; nginx needs
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`).
# SPARAGNE_TRUST_PROXY=true

# Failed logins for one username within the window before it is locked for as
# long again (0 = no limit), and the window in seconds.
SPARAGNE_LOGIN_MAX_FAILURES=5
SPARAGNE_LOGIN_WINDOW_SECS=900

# Failed logins from one client address within the same window (0 = no limit).
SPARAGNE_IP_MAX_FAILURES=30

# Standard env-filter syntax, e.g. "info" or "sparagne_server=debug,info".
RUST_LOG=info
