# Copy to .env next to compose.yml and adjust before `docker compose up -d`.
# See docs/v2/DEPLOY.md for what each variable does.

# Domain Caddy requests a certificate for and proxies to sparagne:3000.
DOMAIN=sparagne.example.com

# Open only long enough to create the first accounts, then set to false and
# restart the sparagne service.
SPARAGNE_ALLOW_REGISTRATION=true

# How many days a login token stays valid.
SPARAGNE_TOKEN_TTL_DAYS=30

# Standard env-filter syntax, e.g. "info" or "sparagne_server=debug,info".
RUST_LOG=info
