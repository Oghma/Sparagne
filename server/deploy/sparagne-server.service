[Unit]
Description=Sparagne sync server
After=network-online.target
Wants=network-online.target

[Service]
# Install without Docker: the binary comes from a release archive, which
# also carries this file and .env.example (docs/DEPLOY.md §3.3), or from
# `cargo build --release -p sparagne_server`. From the unpacked archive,
# once:
#
#   sudo useradd --system --home-dir /var/lib/sparagne --shell /usr/sbin/nologin sparagne
#   sudo install -o sparagne -g sparagne -d /var/lib/sparagne
#   sudo install -m 755 sparagne-server /usr/local/bin/sparagne-server
#   sudo install -m 640 -o root -g sparagne .env.example /etc/sparagne.env
#   sudo install -m 644 sparagne-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sparagne-server
#
# /etc/sparagne.env holds SPARAGNE_ALLOW_REGISTRATION, SPARAGNE_TOKEN_TTL_DAYS,
# the login limits, SPARAGNE_TRUST_PROXY and RUST_LOG (docs/DEPLOY.md);
# SPARAGNE_BIND and SPARAGNE_DATA_DIR are set below since they describe this
# machine, not the deployment's policy.
#
# Accounts, as the service user so SQLite's side files keep their owner
# (`runuser` is there even where `sudo` is not):
#
#   printf '%s\n' "$PW" | runuser -u sparagne -- env SPARAGNE_DATA_DIR=/var/lib/sparagne \
#       /usr/local/bin/sparagne-server user add alice
User=sparagne
Group=sparagne
EnvironmentFile=/etc/sparagne.env
Environment=SPARAGNE_BIND=127.0.0.1:3000
Environment=SPARAGNE_DATA_DIR=/var/lib/sparagne
ExecStart=/usr/local/bin/sparagne-server
Restart=on-failure
RestartSec=2

# Hardening. SQLite (WAL mode) needs to create/write/lock ordinary files in
# the data dir, which ReadWritePaths grants without disabling the rest of
# ProtectSystem=strict; it needs no other filesystem, network or capability
# access.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sparagne
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
