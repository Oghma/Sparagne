    "A vault holds your wallets, envelopes and transactions. A wallet is where the money sits; an envelope is what it is meant for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vault holds your wallets, envelopes and transactions. A wallet is where the money sits; an envelope is what it is meant for."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vault contiene i tuoi wallet, le tue buste e le transazioni. Il wallet è dove i soldi stanno, la busta è a cosa sono destinati."
          }
        }
      }
    },
