    "A template whose owner is no longer a member of this vault records nothing until it has another owner. Its periods can still be skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template whose owner is no longer a member of this vault records nothing until it has another owner. Its periods can still be skipped."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello il cui titolare non è più membro di questo vault non registra nulla finché non ne ha un altro. I suoi periodi si possono comunque saltare."
          }
        }
      }
    },
