    "The owner stopped sharing these vaults with you, or they were removed from the server. What was synced before stays here, read-only, until you remove it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner stopped sharing these vaults with you, or they were removed from the server. What was synced before stays here, read-only, until you remove it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proprietario ha smesso di condividere questi vault con te, oppure sono stati tolti dal server. Quello che era già sincronizzato resta qui, in sola lettura, finché non lo rimuovi."
          }
        }
      }
    },
