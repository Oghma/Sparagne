    "Each line becomes a transfer in the ledger, with the same note and date. All of them go through or none does: if one line cannot, nothing moves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line becomes a transfer in the ledger, with the same note and date. All of them go through or none does: if one line cannot, nothing moves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga diventa un trasferimento nel Mastro, con la stessa nota e la stessa data. Passano tutti o nessuno: se una riga non può passare, non si sposta niente."
          }
        }
      }
    },
